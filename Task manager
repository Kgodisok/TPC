<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>SkillsTrack - Task Manager</title>

    <link
        rel="stylesheet"
        href="css/style.css">

</head>

<body>

<header class="dashboard-header">

    <div class="logo">
        SkillsTrack
    </div>

    <div>
        <span id="taskWelcome">
            Task Manager
        </span>
    </div>

    <button
        id="signOutTaskBtn"
        class="danger-button">

        Sign Out

    </button>

</header>


<main class="task-page">

    <section class="task-header">

        <div>
            <h1>Task Manager</h1>

            <p>
                Create, view, update and delete your learning tasks.
            </p>
        </div>

        <a
            href="dashboard.html"
            class="secondary-button">

            Back to Dashboard

        </a>

    </section>


    <!-- CREATE TASK -->

    <section class="task-form-card">

        <h2>Create Task</h2>

        <form id="taskForm">

            <label for="taskTitle">
                Task Title
            </label>

            <input
                type="text"
                id="taskTitle"
                placeholder="Enter task title"
                required
            >

            <label for="taskDescription">
                Description
            </label>

            <textarea
                id="taskDescription"
                placeholder="Enter task description"
                required>
            </textarea>

            <label for="taskStatus">
                Status
            </label>

            <select id="taskStatus">

                <option value="Outstanding">
                    Outstanding
                </option>

                <option value="Completed">
                    Completed
                </option>

            </select>

            <button
                type="submit"
                class="primary-button">

                Create Task

            </button>

        </form>

    </section>


    <!-- TASK LIST -->

    <section class="task-list-card">

        <div class="task-list-header">

            <h2>My Tasks</h2>

            <div class="task-controls">

                <input
                    type="text"
                    id="taskSearch"
                    placeholder="Search tasks">

                <select id="taskFilter">

                    <option value="All">
                        All Tasks
                    </option>

                    <option value="Completed">
                        Completed
                    </option>

                    <option value="Outstanding">
                        Outstanding
                    </option>

                </select>

            </div>

        </div>


        <div id="taskList">

            <!-- Tasks will be inserted here -->

        </div>

    </section>

</main>

<script src="js/app.js"></script>

</body>

</html>