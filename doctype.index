<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>SquareSchools | Learner Dashboard</title>

    <link
        rel="stylesheet"
        href="styles/landingPage.css"
    >

</head>

<body class="dashboard-body">


<!-- =====================================================
     TOP NAVIGATION
===================================================== -->

<header class="dashboard-navbar">

    <div class="brand">

        <img
            src="images/logo.svg"
            alt="SquareSchools logo"
            class="logo"
        >

        <span>SquareSchools</span>

    </div>


    <div class="authenticated-state">

        <span
            id="authIndicator"
            class="auth-indicator"
        ></span>

        <span id="authStatus">
            Authenticated User
        </span>

    </div>

</header>


<!-- =====================================================
     AUTHENTICATION BAR
===================================================== -->

<section class="auth-bar">

    <div class="auth-input">

        <label for="username">
            Username
        </label>

        <input
            type="text"
            id="username"
            placeholder="Enter username"
        >

    </div>


    <div class="auth-input">

        <label for="password">
            Password
        </label>

        <input
            type="password"
            id="password"
            placeholder="Enter password"
        >

    </div>


    <button
        type="button"
        id="signInBtn"
    >
        Sign In
    </button>


    <button
        type="button"
        id="signOutBtn"
    >
        Sign Out
    </button>


    <div class="create-account-container">

        <button
            type="button"
            id="createAccountBtn"
        >
            Create Account
        </button>

    </div>

</section>


<!-- =====================================================
     MAIN DASHBOARD
===================================================== -->

<div class="dashboard-layout">


<!-- =====================================================
     LEFT SIDEBAR
===================================================== -->

<aside class="dashboard-sidebar left-sidebar">

    <h2>
        Task Manager
    </h2>


    <button
        type="button"
        id="createTaskBtn"
    >
        ➕ Create Task
    </button>


    <button
        type="button"
        id="readTaskBtn"
    >
        📖 View Tasks
    </button>


    <button
        type="button"
        id="updateTaskBtn"
    >
        ✏️ Update Task
    </button>


    <button
        type="button"
        id="deleteTaskBtn"
    >
        🗑️ Delete Task
    </button>


    <hr>


    <h2>
        Learner Progress
    </h2>


    <div class="stat">

        <span>
            Task Total
        </span>

        <strong id="taskTotal">
            0
        </strong>

    </div>


    <div class="stat">

        <span>
            Completed Work
        </span>

        <strong id="completedTasks">
            0
        </strong>

    </div>


    <div class="stat">

        <span>
            Outstanding Work
        </span>

        <strong id="outstandingTasks">
            0
        </strong>

    </div>


    <div class="stat">

        <span>
            Calculated Progress
        </span>

        <strong id="progressPercent">
            0%
        </strong>

    </div>


    <div class="progress-bar">

        <div
            id="progressFill"
            class="progress-fill"
        ></div>

    </div>


    <button
        type="button"
        id="profileBtn"
    >
        👤 Profile
    </button>

</aside>


<!-- =====================================================
     CENTER CONTENT
===================================================== -->

<main class="dashboard-main">

    <div class="dashboard-heading">

        <h1>
            Hello, Welcome to SquareSchools
        </h1>

        <p>
            Learner Dashboard
        </p>

    </div>


    <!-- DASHBOARD CARDS -->

    <section class="dashboard-cards">


        <article class="dashboard-card">

            <h2>
                📚 Activities
            </h2>

            <p>
                Manage your learning activities
                and outstanding work.
            </p>

            <button type="button">
                Open Activities
            </button>

        </article>


        <article class="dashboard-card">

            <h2>
                🧮 Marks Calculator
            </h2>

            <div class="marks-calculator">

                <input
                    type="number"
                    id="mark1"
                    placeholder="Mark 1"
                    min="0"
                    max="100"
                >

                <input
                    type="number"
                    id="mark2"
                    placeholder="Mark 2"
                    min="0"
                    max="100"
                >

                <input
                    type="number"
                    id="mark3"
                    placeholder="Mark 3"
                    min="0"
                    max="100"
                >

                <button
                    type="button"
                    id="calculateMarksBtn"
                >
                    Calculate
                </button>

                <p>
                    Average:
                    <strong id="marksResult">
                        0%
                    </strong>
                </p>

            </div>

        </article>


        <!-- TIMER -->

        <article class="dashboard-card">

            <h2>
                ⏱ Study Timer
            </h2>

            <div
                id="timerDisplay"
                class="timer-display"
            >
                25:00
            </div>

            <button
                type="button"
                id="startTimerBtn"
            >
                Start
            </button>

            <button
                type="button"
                id="pauseTimerBtn"
            >
                Pause
            </button>

            <button
                type="button"
                id="resetTimerBtn"
            >
                Reset
            </button>

        </article>


        <!-- MINI GAME -->

        <article class="dashboard-card">

            <h2>
                🎮 Mini Game
            </h2>

            <p>
                Test your knowledge and improve
                your learning score.
            </p>

            <button
                type="button"
                id="startGameBtn"
            >
                Start Game
            </button>

            <div
                id="gameArea"
                hidden
            >

                <p id="gameQuestion"></p>

                <input
                    type="number"
                    id="gameAnswer"
                    placeholder="Your answer"
                >

                <button
                    type="button"
                    id="submitGameBtn"
                >
                    Submit Answer
                </button>

                <p id="gameScore">
                    Score: 0
                </p>

            </div>

        </article>


        <!-- PROGRESS -->

        <article class="dashboard-card">

            <h2>
                📈 Progress Summary
            </h2>

            <p>
                Your current learning progress:
            </p>

            <strong
                id="summaryProgress"
            >
                0%
            </strong>

            <br><br>

            <button
                type="button"
                id="printProgressBtn"
            >
                🖨 Print Progress Summary
            </button>

        </article>


        <!-- MULTIMEDIA -->

        <article class="dashboard-card">

            <h2>
                🎥 Learning Resource
            </h2>

            <video
                id="learningVideo"
                controls
                width="100%"
            >

                <source
                    src="assets/video/lesson.mp4"
                    type="video/mp4"
                >

                Your browser does not support video.

            </video>

        </article>

    </section>

</main>


<!-- =====================================================
     RIGHT SIDEBAR
===================================================== -->

<aside class="dashboard-sidebar right-sidebar">


    <h2>
        Learner Tools
    </h2>


    <!-- SUPPORT BOOKING -->

    <button
        type="button"
        id="bookingToggle"
    >
        📅 Support Session Booking
    </button>


    <div
        id="bookingPanel"
        class="expand-panel"
        hidden
    >

        <h3>
            Book Support Session
        </h3>


        <form id="bookingForm">

            <label for="bookingName">
                Name
            </label>

            <input
                type="text"
                id="bookingName"
                required
            >


            <label for="bookingEmail">
                Email
            </label>

            <input
                type="email"
                id="bookingEmail"
                required
            >


            <label for="bookingDate">
                Date
            </label>

            <input
                type="date"
                id="bookingDate"
                required
            >


            <label for="bookingTime">
                Time
            </label>

            <select
                id="bookingTime"
                required
            >

                <option value="">
                    Select Time
                </option>

                <option value="09:00">
                    09:00
                </option>

                <option value="11:00">
                    11:00
                </option>

                <option value="14:00">
                    14:00
                </option>

            </select>


            <button type="submit">
                Book Session
            </button>

        </form>


        <p
            id="bookingStatus"
            aria-live="polite"
        ></p>

    </div>


    <hr>


    <!-- SEARCH -->

    <label for="taskSearch">
        🔍 Search Tasks
    </label>

    <input
        type="search"
        id="taskSearch"
        placeholder="Search..."
    >


    <!-- FILTER -->

    <label for="taskFilter">
        🔽 Filter
    </label>

    <select id="taskFilter">

        <option value="all">
            All Tasks
        </option>

        <option value="completed">
            Completed
        </option>

        <option value="outstanding">
            Outstanding
        </option>

    </select>


    <!-- SORT -->

    <label for="taskSort">
        ↕ Sort
    </label>

    <select id="taskSort">

        <option value="name">
            Name
        </option>

        <option value="date">
            Due Date
        </option>

        <option value="status">
            Status
        </option>

    </select>


    <hr>


    <!-- PREFERENCES -->

    <h3>
        Preferences
    </h3>


    <button
        type="button"
        id="darkThemeBtn"
    >
        🌙 Dark Theme
    </button>


    <button
        type="button"
        id="lightThemeBtn"
    >
        ☀️ Light Theme
    </button>


    <button
        type="button"
        id="displayModeBtn"
    >
        🖥️ Display Mode
    </button>


    <hr>


    <!-- STATUS -->

    <h3>
        System Status
    </h3>


    <p>
        Firebase:
        <strong id="firebaseStatus">
            Not Connected
        </strong>
    </p>


    <p>
        REST API:
        <strong id="apiStatus">
            Not Connected
        </strong>
    </p>

</aside>

</div>


<!-- =====================================================
     JAVASCRIPT
===================================================== -->

<script
    src="ui.js"
    defer
></script>

</body>

</html>