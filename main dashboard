<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SkillsTrack - Dashboard</title>
    <link rel="stylesheet" href="css/style.css">
</head>

<body>

<header class="dashboard-header">

    <div class="logo">SkillsTrack</div>

    <div class="welcome">
        <span id="welcomeMessage">Hello, Welcome!</span>
    </div>

    <div class="auth-buttons">
        <button id="signOutBtn" class="danger-button">
            Sign Out
        </button>
    </div>

</header>

<div class="dashboard-layout">

    <!-- LEFT SIDEBAR -->

    <aside class="sidebar">

        <h2>My Progress</h2>

        <div class="progress-box">
            <span>Total Tasks</span>
            <strong id="totalTasks">17</strong>
        </div>

        <div class="progress-box">
            <span>Completed</span>
            <strong id="completedTasks">12</strong>
        </div>

        <div class="progress-box">
            <span>Outstanding</span>
            <strong id="outstandingTasks">5</strong>
        </div>

        <div class="progress-box">
            <span>Progress</span>
            <strong id="progressPercentage">71%</strong>
        </div>

        <a href="task-manager.html" class="sidebar-button">
            Task Manager
        </a>

    </aside>


    <!-- MAIN CONTENT -->

    <main class="dashboard-main">

        <section class="dashboard-title">

            <h1>Learning Dashboard</h1>

            <p>
                Manage your learning activities and monitor your progress.
            </p>

        </section>

        <section class="dashboard-cards">

            <div class="dashboard-card">

                <h3>My Tasks</h3>

                <p>
                    View and manage your current learning tasks.
                </p>

                <a href="task-manager.html" class="primary-button">
                    Manage Tasks
                </a>

            </div>


            <div class="dashboard-card">

                <h3>Marks Calculator</h3>

                <input
                    type="number"
                    id="mark1"
                    placeholder="Enter mark"
                >

                <input
                    type="number"
                    id="mark2"
                    placeholder="Enter mark"
                >

                <button
                    id="calculateMarksBtn"
                    class="primary-button">
                    Calculate
                </button>

                <p id="marksResult"></p>

            </div>


            <div class="dashboard-card">

                <h3>Programming Game</h3>

                <p>
                    Test your basic programming knowledge.
                </p>

                <button
                    id="gameBtn"
                    class="primary-button">
                    Start Game
                </button>

                <p id="gameResult"></p>

            </div>

        </section>

    </main>


    <!-- RIGHT SIDEBAR -->

    <aside class="support-sidebar">

        <h2>Support Session</h2>

        <form id="supportForm">

            <label for="supportDate">
                Select Date
            </label>

            <input
                type="date"
                id="supportDate"
                required
            >

            <label for="supportReason">
                Reason
            </label>

            <textarea
                id="supportReason"
                placeholder="Describe your support request"
                required>
            </textarea>

            <button
                type="submit"
                class="primary-button full-width">
                Book Session
            </button>

        </form>

        <p id="supportMessage"></p>

    </aside>

</div>

<script src="js/app.js"></script>

</body>
</html>