<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SkillsTrack - Sign In</title>
    <link rel="stylesheet" href="css/style.css">
</head>

<body class="auth-page">

<header class="navbar">
    <div class="logo">SkillsTrack</div>

    <nav>
        <a href="index.html">Home</a>
        <a href="create-account.html" class="nav-button">
            Create Account
        </a>
    </nav>
</header>

<main class="auth-container">

    <div class="auth-card">

        <h1>Sign In</h1>

        <p class="form-description">
            Sign in to access your learner dashboard.
        </p>

        <form id="signInForm">

            <label for="username">Username</label>
            <input
                type="text"
                id="username"
                placeholder="Enter your username"
                required
            >

            <label for="password">Password</label>
            <input
                type="password"
                id="password"
                placeholder="Enter your password"
                required
            >

            <button type="submit" class="primary-button full-width">
                Sign In
            </button>

        </form>

        <p id="signInMessage" class="form-message"></p>

        <p class="auth-link">
            Don't have an account?
            <a href="create-account.html">Create Account</a>
        </p>

    </div>

</main>

<script src="js/app.js"></script>

</body>
</html>